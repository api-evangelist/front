          "docs": "Removes one or more links to a conversation.\nFor more information on links, see the [Links](https://dev.frontapp.com/reference/links) topic.\n\n\nRequired scope: `conversations:write`"
        },
        {
          "info": {
            "name": "List conversation messages",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api2.frontapp.com/conversations/:conversation_id/messages",
            "params": [
              {
                "name": "conversation_id",
                "value": "",
                "type": "path",
                "description": "The conversation ID"
              },
              {
                "name": "limit",
                "value": "",
