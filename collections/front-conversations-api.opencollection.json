          "http": {
            "method": "DELETE",
            "url": "https://api2.frontapp.com/conversations/:conversation_id/followers",
            "params": [
              {
                "name": "conversation_id",
                "value": "",
                "type": "path",
                "description": "The conversation ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Removes teammates from the list of followers of a conversation.\n\nRequired scope: `conversations:write`"
        },
        {
          "info": {
            "name": "List conversation inboxes",
