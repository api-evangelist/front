            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Adds teammates to the list of followers of a conversation.\n\nRequired scope: `conversations:write`"
        },
        {
          "info": {
            "name": "Delete conversation followers",
            "type": "http"
