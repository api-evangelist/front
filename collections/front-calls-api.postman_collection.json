                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "external_call_id",
                  "description": "(Required) The external call ID from the provider system."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "attachments",
                  "type": "file",
                  "description": "(Required) Exactly one audio file (`audio/*`)."
                },
                {
                  "key": "recording_type",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required)  (This can only be one of call,voicemail)"
