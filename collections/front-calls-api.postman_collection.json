        {
          "id": "f2831e0a-de43-418b-b8a7-e9bc3bd8a4ad",
          "name": "Add call recording",
          "request": {
            "name": "Add call recording",
            "description": {
              "content": "Adds a recording to a call in Front. Send `multipart/form-data` with exactly one file in the `attachments` field, `Content-Type: audio/*`, and required `recording_type` (`call` or `voicemail`).\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "channels",
                ":channel_id",
                "calls",
                ":external_call_id",
                "recording"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "cha_123",
                  "key": "channel_id",
                  "description": "(Required) The Channel ID."
