            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new contact list for the requested teammate.\n\nRequired scope: `contacts:write`"
        },
        {
          "info": {
            "name": "List team contact lists",
            "type": "http"
