          },
          "docs": "List contact lists.\n\nRequired scope: `contacts:read`"
        },
        {
          "info": {
            "name": "Create contact list",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api2.frontapp.com/contact_lists",
            "body": {
              "type": "json",
              "data": "{}"
            }
