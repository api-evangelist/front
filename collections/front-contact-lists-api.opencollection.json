{
  "opencollection": "1.0.0",
  "info": {
    "name": "Channel Accounts Contact Lists API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Contact Lists",
