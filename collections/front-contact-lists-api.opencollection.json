          "info": {
            "name": "Create team contact list",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api2.frontapp.com/teams/:team_id/contact_lists",
            "params": [
              {
                "name": "team_id",
                "value": "",
                "type": "path",
